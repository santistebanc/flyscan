{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flight Scraper",
  "version": "0.3.5",
  "identifier": "com.flightscraper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flight Scraper",
        "visible": false,
        "minWidth": 760,
        "minHeight": 560,
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Compare flight fares, routes and connections",
    "category": "Travel",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/flight-scraper-sidecar"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Flight Scraper",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QzlBQzI0MDAzMDIxOTkKUldTWklUQUFKS3pKaEp5NnBUeWlHczNQdHFVY3VzZFhQc2tJN0prVXRyZGZOUjZzcFN6U0VjOHUK",
      "endpoints": [
        "https://github.com/santistebanc/flight-scraper-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
