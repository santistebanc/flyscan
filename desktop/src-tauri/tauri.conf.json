{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flight Scraper",
  "version": "0.3.0",
  "identifier": "com.flightscraper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flight Scraper",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/flight-scraper-sidecar"]
  }
}
