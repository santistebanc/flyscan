{
  "name": "flyscan-backend",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:transport": "tsx --test tests/transport.native.ts",
    "start": "node dist/index.cjs",
    "dev": "tsx watch src/cli.ts serve"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "entities": "9.0.0",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.6"
  }
}
